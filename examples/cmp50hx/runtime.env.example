# Copy to a private local file and set actual model paths before use.
MODEL_DIR=/models/swift-qwen38-awq
SERVED_NAME=swift15-qwen38-awq
SPECULATIVE_MODEL=/models/qwen38-dflash2-gptq-int8

GPU_DEVICES=0,1
TP_SIZE=2
PP_SIZE=1
PORT=8000
PROFILE=2xCMP50HX/qwen27b/w4a16/dflash2-fp8kv-2x221K-text-image.env
MODE=fast

SPECULATIVE_DRAFT_TP_SIZE=2
SPECULATIVE_KV_CACHE_DTYPE=float16
SPECULATIVE_ATTENTION_BACKEND=TRITON_ATTN
ENABLE_PREFIX_CACHING=1
MAMBA_CACHE_MODE=align
PER_REQUEST_SPEC_DECODE_METRICS=summary
TOOL_CALL_PARSER=qwen3_xml
REASONING_PARSER=qwen3
ENABLE_AUTO_TOOL_CHOICE=1
CUSTOM_ALL_REDUCE_MODE=off
VLLM_ENFORCE_STRICT_TOOL_CALLING=0
VLLM_ALLOW_MAMBA_SPEC_FULL_CUDAGRAPH=1
